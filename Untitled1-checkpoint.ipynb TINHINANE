   "source": [
    "import numpy as np\n",
    "T = np.array([20, 30, 35, 40])\n",
    "C = np.array([40, 70, 85, 100])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "a26f6d05-b468-4eca-a235-2b4f67ec40b7",
