     "text": [
      "valeurs préditesq: [ 40.  70.  85. 100.]\n"
     ]
    }
   ],
   "source": [
    "Y_pred = model.predict(X)\n",
    "print(\"valeurs préditesq:\", Y_pred)"
   ]
